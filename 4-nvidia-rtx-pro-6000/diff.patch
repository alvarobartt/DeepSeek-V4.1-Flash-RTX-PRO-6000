+    if (splits == 2) return launch_mma<Warps, 2>(x, w, out, partial, m, xt, xg, stream);
+    if (splits == 4) return launch_mma<Warps, 4>(x, w, out, partial, m, xt, xg, stream);
+    if (splits == 8) return launch_mma<Warps, 8>(x, w, out, partial, m, xt, xg, stream);
+    if (splits == 16) return launch_mma<Warps, 16>(x, w, out, partial, m, xt, xg, stream);
+    return int(cudaErrorInvalidValue);
+}
+
+extern "C" int launch_woa(void* x, void* w, void* out, void* partial, int m,
+        int64_t xt, int64_t xg, int warps, int splits, void* stream) {
+    if (m < 1 || m > 8 || (xt & 1) || (xg & 1) || xt <= 0 || xg <= 0)
