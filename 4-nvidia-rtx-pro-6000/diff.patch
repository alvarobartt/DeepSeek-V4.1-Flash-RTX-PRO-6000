+    const int part = lane % 4;
+    const int nbase = (blockIdx.x * Warps + threadIdx.x / 32) * 8;
+    const int batch = blockIdx.y;
+    const int split = blockIdx.z;
+    const int begin = split * (4096 / Splits);
+    const int end = begin + 4096 / Splits;
