+
+template<int Splits>
+__global__ void woa_mma_reduce(const float* __restrict__ partial,
+                             __nv_bfloat16* __restrict__ out, int count) {
+    const int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= count) return;
+    float sum = 0;
+    #pragma unroll
+    for (int split = 0; split < Splits; ++split)
+        sum += partial[split * count + index];
+    out[index] = __float2bfloat16_rn(sum);
