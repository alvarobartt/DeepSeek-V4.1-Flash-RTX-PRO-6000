+@triton.jit
+def tile_prefix(OFF,PREFIX,E:tl.constexpr,BM:tl.constexpr,BLOCK:tl.constexpr):
+    expert=tl.arange(0,BLOCK)
+    first=tl.load(OFF+expert,expert<E,0)
+    last=tl.load(OFF+expert+1,expert<E,0)
+    count=tl.cdiv(last-first,BM)
+    cumulative=tl.cumsum(count)
+    tl.store(PREFIX,0)
+    tl.store(PREFIX+expert+1,cumulative,expert<E)
+
+
+@triton.jit(do_not_specialize=['PAIRS','AS1'])
+def routed_gemm(Q,W,AS,BS,PREFIX,IDS,OFF,Y,N:tl.constexpr,K:tl.constexpr,PAIRS,QS0:tl.constexpr,
+                AS0:tl.constexpr,AS1,BS0:tl.constexpr,BS1:tl.constexpr,BS2:tl.constexpr,
+                PACKED:tl.constexpr,PACKED_WS:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,SPLITS:tl.constexpr,BM:tl.constexpr,E:tl.constexpr):
+    tile=tl.program_id(1)
+    if tile<tl.load(PREFIX+E):
+        experts=tl.arange(0,triton.next_power_of_2(E))
+        stops=tl.load(PREFIX+experts+1,experts<E,2147483647)
+        expert=tl.sum((tile>=stops).to(tl.int32))
+        first=tl.load(OFF+expert)
+        end=tl.load(OFF+expert+1)
+        dest=first+(tile-tl.load(PREFIX+expert))*BM
+        if dest<end:
+            row=dest+tl.arange(0,BM)
+            col=tl.program_id(0)*BN+tl.arange(0,BN)
+            ki=tl.arange(0,BK)
+            kp=tl.arange(0,BK//2)
+            groups=tl.arange(0,BK//32)
+            acc=tl.full((BM,BN),0,tl.float32)
+            for step in range(tl.cdiv(K,BK*SPLITS)):
+                begin=tl.program_id(2)*tl.cdiv(K,BK*SPLITS)+step
+                k=begin*BK+ki
+                a=tl.load(Q+row[:,None]*QS0+k[None,:],(row[:,None]<end)&(k[None,:]<K),0.0)
+                packed=begin*(BK//2)+kp
+                b=tl.load(W+expert*N*(K//2)+col[:,None]*(K//2)+packed[None,:],(col[:,None]<N)&(packed[None,:]<K//2),0)
+                group=begin*(BK//32)+groups
+                ag=group//4
+                if PACKED:
+                    word=tl.load(AS+row[:,None]*AS0+(ag[None,:]//4)*AS1,(row[:,None]<end)&(group[None,:]<K//32),0)
+                    a_scale=((word>>((ag[None,:]%4)*8))&255).to(tl.uint8)
+                else:
+                    scale=tl.load(AS+row[:,None]*AS0+ag[None,:]*AS1,(row[:,None]<end)&(group[None,:]<K//32),0.)
+                    a_scale=((scale.to(tl.int32,bitcast=True)>>23)&255).to(tl.uint8)
+                if PACKED_WS:
+                    word=tl.load(BS+expert*BS0+col[:,None]*BS1+(group[None,:]//4)*BS2,(col[:,None]<N)&(group[None,:]<K//32),0)
+                    b_scale=((word>>((group[None,:]%4)*8))&255).to(tl.uint8)
+                else:
+                    b_scale=tl.load(BS+expert*BS0+col[:,None]*BS1+group[None,:]*BS2,(col[:,None]<N)&(group[None,:]<K//32),0).to(tl.uint8)
+                low=(b&15)<<2
+                high=(b>>4)<<2
+                expanded=tl.interleave(low,high).to(tl.float8e4nv,bitcast=True)
+                acc=tl.dot_scaled(a,a_scale,'e4m3',tl.trans(expanded),b_scale,'e4m3',acc=acc)
+            tl.store(Y+tl.program_id(2)*PAIRS*N+row[:,None]*N+col[None,:],acc,(row[:,None]<end)&(col[None,:]<N))
+
+
+@triton.jit(do_not_specialize=['PAIRS'])
+def weighted_reduce(P,DST,RW,Y,N:tl.constexpr,PAIRS,TOPK:tl.constexpr,SPLITS:tl.constexpr,BLOCK:tl.constexpr):
+    token=tl.program_id(0)
+    cols=tl.program_id(1)*BLOCK+tl.arange(0,BLOCK)
+    total=tl.full((BLOCK,),0,tl.float32)
+    for slot in range(TOPK):
+        row=tl.load(DST+token*TOPK+slot)
+        weight=tl.load(RW+token*TOPK+slot)
+        value=tl.full((BLOCK,),0,tl.float32)
+        for split in range(SPLITS):
+            value+=tl.load(P+split*PAIRS*N+row*N+cols,(row>=0)&(cols<N),0)
+        value=value.to(tl.bfloat16).to(tl.float32)
+        total+=value*weight
+    tl.store(Y+token*N+cols,total,cols<N)
+
+
+_COMPILED={}
+_CALLS=0
+_SHAPES=set()
+_PREFIX={}
