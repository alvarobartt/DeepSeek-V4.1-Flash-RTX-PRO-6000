+
+template<int Warps, int Splits>
+int launch_mma(void* x, void* w, void* out, void* partial, int m,
+               int64_t xt, int64_t xg, cudaStream_t stream) {
+    woa_bf16_mma<Warps, Splits><<<dim3(1024 / (Warps * 8), 2, Splits), Warps * 32, 0, stream>>>(
+        static_cast<const uint32_t*>(x), static_cast<const uint32_t*>(w),
+        static_cast<__nv_bfloat16*>(out), static_cast<float*>(partial), m, xt, xg);
+    cudaError_t error = cudaGetLastError();
+    if (error != cudaSuccess) return int(error);
