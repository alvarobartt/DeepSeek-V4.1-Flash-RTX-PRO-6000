+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+__global__ void publish_host4_boundary(const uint32_t* input, uint64_t* shared,
+                             uint32_t* counter, int words, int stride, int rank) {
+    __shared__ uint32_t epoch;
+    if (threadIdx.x == 0) epoch = atomicAdd(counter, 1u) + 1u;
+    __syncthreads();
+    uint64_t* slot = shared + size_t(epoch & 1u) * 4 * stride;
+    const bool boundary = (epoch & 0x7ffffffeu) == 0;
+    if (boundary) {
+        const uint64_t cleared = uint64_t(epoch & 0x80000000u) << 32;
+        for (int i = threadIdx.x; i < stride; i += blockDim.x) {
+            uint64_t* address = slot + size_t(rank) * stride + i;
+            asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(cleared) : "memory");
+        }
+        __syncthreads();
+    }
+    for (int i = threadIdx.x; i < words; i += blockDim.x) {
+        uint64_t packet = (uint64_t(epoch) << 32) | input[i];
+        uint64_t* address = slot + size_t(rank) * stride + i;
+        asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(packet) : "memory");
+    }
+    __threadfence_system();
+    if (boundary) {
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            const uint64_t phase = ((epoch & 0x80000000u) ? 1u : 3u) + (epoch & 1u);
+            uint64_t* ready = shared + size_t(2) * 4 * stride + size_t(epoch & 1u) * 4 + rank;
+            asm volatile("st.release.sys.global.u64 [%0], %1;" :: "l"(ready), "l"(phase) : "memory");
+        }
+    }
+}
+
+__global__ void reduce_scatter_host4_boundary(const uint32_t* input, uint32_t* output,
+                            uint64_t* shared, const uint32_t* counter, int* error,
+                            int words, int stride, int rank) {
+    if (*error) return;
+    __shared__ uint32_t values[4][32];
+    const int lane = threadIdx.x & 31;
+    const int peer = threadIdx.x / 32;
+    const int chunk = (words + 3) / 4;
+    const int end = min((rank + 1) * chunk, words);
+    const int i = rank * chunk + blockIdx.x * 32 + lane;
+    const uint32_t epoch = *counter;
+    if ((epoch & 0x7ffffffeu) == 0) {
+        if (threadIdx.x == 0) {
+            const uint64_t phase = ((epoch & 0x80000000u) ? 1u : 3u) + (epoch & 1u);
+            const uint64_t* ready = shared + size_t(2) * 4 * stride + size_t(epoch & 1u) * 4;
+            const uint64_t deadline = clock64() + 180000000000ull;
+            for (int source = 0; source < 4; ++source) {
+                uint64_t observed;
+                do {
+                    asm volatile("ld.acquire.sys.global.u64 %0, [%1];" : "=l"(observed) : "l"(ready + source) : "memory");
+                    if (observed != phase && clock64() > deadline) {
+                        if (atomicCAS(error, 0, source + 1) == 0) {
+                            error[1] = -1; error[2] = 0;
+                            error[3] = uint32_t(observed); error[4] = uint32_t(phase);
+                            error[5] = 3;
+                        }
+                        asm volatile("trap;");
+                        return;
+                    }
+                } while (observed != phase);
+            }
+        }
+        __syncthreads();
+    }
+    uint64_t* slot = shared + size_t(epoch & 1u) * 4 * stride;
+    uint32_t value = 0;
+    if (i < end) {
+        if (peer == rank) value = input[i];
+        else {
+            const uint64_t* address = slot + size_t(peer) * stride + i;
+            const uint64_t deadline = clock64() + 180000000000ull;
+            uint64_t packet;
+            do {
+                asm volatile("ld.volatile.global.u64 %0, [%1];" : "=l"(packet) : "l"(address) : "memory");
+                if (uint32_t(packet >> 32) != epoch && clock64() > deadline) {
+                    if (atomicCAS(error, 0, peer + 1) == 0) {
+                        error[1] = i; error[2] = uint32_t(packet);
+                        error[3] = uint32_t(packet >> 32); error[4] = epoch;
+                    }
+                    asm volatile("trap;");
+                    return;
+                }
+            } while (uint32_t(packet >> 32) != epoch);
+            value = uint32_t(packet);
+        }
+    }
+    values[peer][lane] = value;
+    __syncthreads();
+    if (peer == 0 && i < end) {
+        float x = 0.0f, y = 0.0f;
+        #pragma unroll
+        for (int source = 0; source < 4; ++source) {
+            uint32_t packed = values[source][lane];
+            __nv_bfloat162 bf;
+            *reinterpret_cast<uint32_t*>(&bf) = packed;
+            float2 pair = __bfloat1622float2(bf);
+            x += pair.x;
+            y += pair.y;
+        }
+        __nv_bfloat162 result = __floats2bfloat162_rn(x, y);
+        const uint32_t packed = *reinterpret_cast<uint32_t*>(&result);
+        output[i] = packed;
+        const uint64_t packet = (uint64_t(epoch ^ 0x80000000u) << 32) | packed;
+        uint64_t* address = slot + size_t(rank) * stride + i;
+        asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(packet) : "memory");
+        __threadfence_system();
+    }
+}
+
+__global__ void gather_host_results4_boundary(uint32_t* output, uint64_t* shared,
+                                    const uint32_t* counter, int* error,
+                                    int words, int stride, int rank) {
+    if (*error) return;
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= words) return;
+    const int chunk = (words + 3) / 4;
+    const int owner = i / chunk;
+    if (owner == rank) return;
+    const uint32_t epoch = *counter;
+    const uint32_t tag = epoch ^ 0x80000000u;
+    const uint64_t* address = shared + size_t(epoch & 1u) * 4 * stride + size_t(owner) * stride + i;
+    const uint64_t deadline = clock64() + 180000000000ull;
+    uint64_t packet;
+    do {
+        asm volatile("ld.volatile.global.u64 %0, [%1];" : "=l"(packet) : "l"(address) : "memory");
+        if (uint32_t(packet >> 32) != tag && clock64() > deadline) {
+            if (atomicCAS(error, 0, owner + 1) == 0) {
+                error[1] = i; error[2] = uint32_t(packet);
+                error[3] = uint32_t(packet >> 32); error[4] = tag;
+            }
+            asm volatile("trap;");
+            return;
+        }
+    } while (uint32_t(packet >> 32) != tag);
+    output[i] = uint32_t(packet);
+}
+
+extern "C" int register_host(void* host, size_t bytes, int device, void** mapped) {
+    cudaError_t e = cudaSetDevice(device);
+    if (e != cudaSuccess) return e;
+    e = cudaHostRegister(host, bytes, cudaHostRegisterPortable | cudaHostRegisterMapped);
+    if (e != cudaSuccess) return e;
+    return cudaHostGetDevicePointer(mapped, host, 0);
+}
+extern "C" int unregister_host(void* host) { return cudaHostUnregister(host); }
+extern "C" const char* error_text(int code) { return cudaGetErrorString(cudaError_t(code)); }
+extern "C" int launch_host_ll(void* input, void* output, void* shared,
+                              void* counter, void* error, int words, int stride,
+                              int rank, int threads, void* stream) {
+    auto s = reinterpret_cast<cudaStream_t>(stream);
+    publish_host4_boundary<<<1, 1024, 0, s>>>(static_cast<uint32_t*>(input),
+        static_cast<uint64_t*>(shared), static_cast<uint32_t*>(counter), words, stride, rank);
+    cudaError_t result = cudaGetLastError();
+    if (result != cudaSuccess) return result;
+    const int chunk = (words + 3) / 4;
+    const int blocks = (chunk + 31) / 32;
+    reduce_scatter_host4_boundary<<<blocks ? blocks : 1, 128, 0, s>>>(
+        static_cast<uint32_t*>(input), static_cast<uint32_t*>(output),
+        static_cast<uint64_t*>(shared), static_cast<uint32_t*>(counter),
+        static_cast<int*>(error), words, stride, rank);
+    result = cudaGetLastError();
+    if (result != cudaSuccess) return result;
+    const int gather_blocks = (words + 127) / 128;
+    gather_host_results4_boundary<<<gather_blocks ? gather_blocks : 1, 128, 0, s>>>(
+        static_cast<uint32_t*>(output), static_cast<uint64_t*>(shared),
+        static_cast<uint32_t*>(counter), static_cast<int*>(error), words, stride, rank);
+    return cudaGetLastError();
+}
+
+extern "C" int prepare_kernel() {
+    cudaFuncAttributes a;
+    cudaError_t e = cudaFuncGetAttributes(&a, publish_host4_boundary);
+    if (e != cudaSuccess) return e;
+    e = cudaFuncGetAttributes(&a, reduce_scatter_host4_boundary);
+    if (e != cudaSuccess) return e;
+    return cudaFuncGetAttributes(&a, gather_host_results4_boundary);
+}
