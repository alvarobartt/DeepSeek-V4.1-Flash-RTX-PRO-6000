+
+
+@triton.jit
+def _pack_argmax(Logits, Pairs, stride, count, start, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    col = tl.arange(0, BLOCK)
+    values = tl.load(Logits + row * stride + col, col < count, other=-float('inf')).to(tl.float32)
+    best = tl.max(values, 0)
+    index = tl.min(tl.where((col < count) & (values == best), col, 2147483647), 0)
+    tl.store(Pairs + row * 2, best)
+    tl.store(Pairs + row * 2 + 1, (index + start).to(tl.float32))
+
+
+@triton.jit
+def _verify_pairs(Pairs, Cu, Idx, Input, Positions, LogitIndices, LocalPos,
+                  Prefill, SeqLens, Sampled, Counts, Rejected,
+                  TP: tl.constexpr, STEPS: tl.constexpr, WIDTH: tl.constexpr):
+    req = tl.program_id(0)
+    begin = tl.load(Cu + req)
+    end = tl.load(Cu + req + 1)
+    state = tl.load(Idx + req)
+    prefill = tl.load(Prefill + state)
+    step = tl.arange(0, WIDTH)
+    rank = tl.arange(0, TP)
+    row = begin + step
+    values = tl.load(Pairs + row[:, None] * (TP * 2) + rank[None, :] * 2,
+                     row[:, None] < end, other=-float('inf'))
+    ids = tl.load(Pairs + row[:, None] * (TP * 2) + rank[None, :] * 2 + 1,
+                  row[:, None] < end, other=2147483647).to(tl.int64)
+    best = tl.max(values, 1)
+    target = tl.min(tl.where(values == best[:, None], ids, 2147483647), 1)
+    next_row = row + 1
+    next_valid = next_row < end
+    next_index = tl.load(LogitIndices + next_row, next_valid, other=0)
+    draft = tl.load(Input + next_index, next_valid, other=-1).to(tl.int64)
+    pos = tl.load(Positions + next_index, next_valid, other=0)
+    local = tl.load(LocalPos + next_row, next_valid, other=0)
