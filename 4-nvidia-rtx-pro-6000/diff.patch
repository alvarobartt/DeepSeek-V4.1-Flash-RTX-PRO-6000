+@triton.jit(do_not_specialize=['PAIRS','AS1'])
+def routed_gemm(Q,W,AS,BS,DST,IDS,OFF,Y,N:tl.constexpr,K:tl.constexpr,PAIRS,QS0:tl.constexpr,
+                AS0:tl.constexpr,AS1,BS0:tl.constexpr,BS1:tl.constexpr,BS2:tl.constexpr,
+                PACKED:tl.constexpr,PACKED_WS:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,SPLITS:tl.constexpr,BM:tl.constexpr):
+    pair=tl.program_id(1)
+    expert=tl.load(IDS+pair)
+    dest=tl.load(DST+pair)
