+
+class Sm120HostAllReduce:
+    def __init__(self, group, device, library=None):
+        self.disabled = True
+        self.mapping = None
+        self.device = torch.device(device)
+        self.rank = dist.get_rank(group)
+        library = "/usr/local/lib/libvllm-sm120-host-ll.so" if library is None else str(library)
+        if dist.get_world_size(group) != 4 or not os.path.isfile(library):
+            return
+        if not current_platform.is_device_capability_family(120):
+            return
+        if not all(in_the_same_node_as(group, source_rank=0)):
+            return
+        self.lib = ctypes.CDLL(library)
+        self.lib.register_host.argtypes = [
+            ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int,
+            ctypes.POINTER(ctypes.c_void_p),
+        ]
+        self.lib.register_host.restype = ctypes.c_int
+        self.lib.unregister_host.argtypes = [ctypes.c_void_p]
+        self.lib.error_text.argtypes = [ctypes.c_int]
+        self.lib.error_text.restype = ctypes.c_char_p
+        self.lib.prepare_kernel.restype = ctypes.c_int
+        self.lib.launch_host_ll.argtypes = (
+            [ctypes.c_void_p] * 5 + [ctypes.c_int] * 4 + [ctypes.c_void_p]
+        )
+        self.lib.launch_host_ll.restype = ctypes.c_int
+        self.max_rows = 128
+        self.dispatch_rows = 64
+        self.stride = self.max_rows * 5120 // 2
+        self.ready_offset = 2 * 4 * self.stride * 8
+        size = self.ready_offset + 2 * 4 * 8
+        paths = ['/dev/shm/vllm-sm120-' + uuid.uuid4().hex if self.rank == 0 else None]
+        dist.broadcast_object_list(paths, src=dist.get_process_group_ranks(group)[0], group=group)
+        path = paths[0]
+        if self.rank == 0:
+            fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+            os.ftruncate(fd, size)
+        dist.barrier(group=group)
+        if self.rank != 0:
+            fd = os.open(path, os.O_RDWR)
+        try:
+            self.mapping = mmap.mmap(fd, size, flags=mmap.MAP_SHARED)
+        finally:
+            os.close(fd)
+        for slot in range(2):
+            offset = (slot * 4 + self.rank) * self.stride * 8
+            self.mapping[offset:offset + self.stride * 8] = bytes(self.stride * 8)
+        for slot in range(2):
+            offset = self.ready_offset + (slot * 4 + self.rank) * 8
+            self.mapping[offset:offset + 8] = bytes(8)
+        dist.barrier(group=group)
+        self.host = ctypes.addressof(ctypes.c_char.from_buffer(self.mapping))
+        self.mapped = ctypes.c_void_p()
+        self.check(self.lib.register_host(self.host, size, self.device.index, ctypes.byref(self.mapped)))
+        dist.barrier(group=group)
+        if self.rank == 0:
+            os.unlink(path)
+        self.counter = torch.zeros(1, device=self.device, dtype=torch.int32)
+        self.errors = torch.zeros(8, device=self.device, dtype=torch.int32)
+        self.check(self.lib.prepare_kernel())
+        self.disabled = False
+
+    def check(self, code):
+        if code:
+            raise RuntimeError(self.lib.error_text(code).decode())
+
+    def should_use(self, tensor):
+        return (
+            not self.disabled
+            and tensor.device == self.device
+            and tensor.dtype == torch.bfloat16
+            and tensor.is_contiguous()
+            and tensor.ndim == 2
+            and tensor.shape[-1] == 5120
+            and 1 <= tensor.shape[0] <= self.dispatch_rows
+        )
+
+    def all_reduce(self, tensor):
+        output = torch.empty_like(tensor)
+        self.check(self.lib.launch_host_ll(
+            tensor.data_ptr(), output.data_ptr(), self.mapped.value,
+            self.counter.data_ptr(), self.errors.data_ptr(), tensor.numel() // 2,
+            self.stride, self.rank, 128, torch.cuda.current_stream().cuda_stream,
+        ))
+        return output
+
+    def destroy(self):
+        if self.mapping is not None:
+            torch.cuda.synchronize(self.device)
+            self.check(self.lib.unregister_host(self.host))
+            self.mapping.close()
+            self.mapping = None
+        self.disabled = True
