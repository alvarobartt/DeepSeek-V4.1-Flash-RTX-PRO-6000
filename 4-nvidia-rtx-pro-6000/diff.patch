+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cooperative_groups.h>
+#include <stdint.h>
+
+#ifndef HOST_RANKS
+#define HOST_RANKS 8
+#endif
+static constexpr int Ranks = HOST_RANKS;
+#ifndef PACKET_LANES
+#define PACKET_LANES 32
+#endif
+static constexpr int PacketLanes = PACKET_LANES;
+static_assert(PacketLanes == 8 || PacketLanes == 16 || PacketLanes == 32);
+static constexpr int Threads = Ranks * PacketLanes;
+static constexpr uint64_t PayloadMask = (uint64_t(1) << 48) - 1;
+static int cooperative_block_limit = 0;
+
+__device__ __forceinline__ uint64_t load_three(const uint16_t* input, int packet, int elements) {
+    uint64_t value = 0;
+    #pragma unroll
+    for (int channel = 0; channel < 3; ++channel) {
+        const int index = packet * 3 + channel;
+        if (index < elements) value |= uint64_t(input[index]) << (channel * 16);
+    }
+    return value;
+}
+
+__device__ __forceinline__ void store_three(uint16_t* output, int packet, int elements, uint64_t value) {
+    #pragma unroll
+    for (int channel = 0; channel < 3; ++channel) {
+        const int index = packet * 3 + channel;
+        if (index < elements) output[index] = uint16_t(value >> (channel * 16));
+    }
+}
+
+__device__ __forceinline__ float decode_bf16(uint64_t value, int channel) {
+    const uint16_t bits = uint16_t(value >> (channel * 16));
+    __nv_bfloat16 result;
+    *reinterpret_cast<uint16_t*>(&result) = bits;
+    return __bfloat162float(result);
+}
+
+__device__ __forceinline__ uint16_t encode_bf16(float value) {
+    __nv_bfloat16 result = __float2bfloat16_rn(value);
+    return *reinterpret_cast<uint16_t*>(&result);
+}
+
+__global__ void cooperative_triplet_host(const uint16_t* input, uint16_t* output,
+                                         uint64_t* shared, uint32_t* counter,
+                                         int* error, int words, int stride, int rank) {
+    if (*error) return;
+    const auto grid = cooperative_groups::this_grid();
+    const uint32_t epoch = *counter + 1u;
+    const uint32_t tag = epoch & 0xffffu;
+    const int elements = words * 2;
+    const int packets = (elements + 2) / 3;
+    const int chunk = ((packets + Ranks * 32 - 1) / (Ranks * 32)) * 32;
+    const int global_thread = blockIdx.x * blockDim.x + threadIdx.x;
+    const int global_threads = gridDim.x * blockDim.x;
+    uint64_t* slot = shared + size_t(epoch & 1u) * Ranks * stride;
+    const bool boundary = (epoch & 0x7ffeu) == 0;
+    if (boundary) {
+        const uint64_t cleared = uint64_t(epoch & 0x8000u) << 48;
+        for (int i = global_thread; i < stride; i += global_threads) {
+            uint64_t* address = slot + size_t(rank) * stride + i;
+            asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(cleared) : "memory");
+        }
+    }
+    for (int i = global_thread; i < packets; i += global_threads) {
+        const uint64_t value = (uint64_t(tag) << 48) | load_three(input, i, elements);
+        uint64_t* address = slot + size_t(rank) * stride + i;
+        asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(value) : "memory");
+    }
+    __threadfence_system();
+    grid.sync();
+    if (blockIdx.x == 0 && threadIdx.x == 0) {
+        *counter = epoch;
+        if (boundary) {
+            const uint64_t phase = ((epoch & 0x8000u) ? 1u : 3u) + (epoch & 1u);
+            uint64_t* ready = shared + size_t(2) * Ranks * stride + size_t(epoch & 1u) * Ranks + rank;
+            asm volatile("st.release.sys.global.u64 [%0], %1;" :: "l"(ready), "l"(phase) : "memory");
+        }
+    }
+    if (boundary) {
+        if (threadIdx.x == 0) {
+            const uint64_t phase = ((epoch & 0x8000u) ? 1u : 3u) + (epoch & 1u);
+            const uint64_t* ready = shared + size_t(2) * Ranks * stride + size_t(epoch & 1u) * Ranks;
+            const uint64_t deadline = clock64() + 180000000000ull;
+            for (int source = 0; source < Ranks; ++source) {
+                uint64_t observed;
+                do {
+                    asm volatile("ld.acquire.sys.global.u64 %0, [%1];" : "=l"(observed) : "l"(ready + source) : "memory");
+                    if (observed != phase && clock64() > deadline) {
+                        if (atomicCAS(error, 0, source + 1) == 0) {
+                            error[1] = -1; error[2] = 0;
+                            error[3] = uint32_t(observed); error[4] = uint32_t(phase); error[5] = 3;
+                        }
+                        asm volatile("trap;");
+                        return;
+                    }
+                } while (observed != phase);
+            }
+        }
+        __syncthreads();
+    }
+    __shared__ uint64_t values[Ranks][PacketLanes];
+    const int lane = threadIdx.x % PacketLanes;
+    const int peer = threadIdx.x / PacketLanes;
+    const int end = min((rank + 1) * chunk, packets);
+    const int i = rank * chunk + blockIdx.x * PacketLanes + lane;
+    uint64_t value = 0;
+    if (i < end) {
+        if (peer == rank) value = load_three(input, i, elements);
+        else {
+            const uint64_t* address = slot + size_t(peer) * stride + i;
+            const uint64_t deadline = clock64() + 180000000000ull;
+            uint64_t packet;
+            do {
+                asm volatile("ld.volatile.global.u64 %0, [%1];" : "=l"(packet) : "l"(address) : "memory");
+                if (uint32_t(packet >> 48) != tag && clock64() > deadline) {
+                    if (atomicCAS(error, 0, peer + 1) == 0) {
+                        error[1] = i; error[2] = uint32_t(packet);
+                        error[3] = uint32_t(packet >> 48); error[4] = tag;
+                    }
+                    asm volatile("trap;");
+                    return;
+                }
+            } while (uint32_t(packet >> 48) != tag);
+            value = packet & PayloadMask;
+        }
+    }
+    values[peer][lane] = value;
+    __syncthreads();
+    if (peer == 0 && i < end) {
+        float x = 0.0f, y = 0.0f, z = 0.0f;
+        #pragma unroll
+        for (int source = 0; source < Ranks; ++source) {
+            const uint64_t packed = values[source][lane];
+            x += decode_bf16(packed, 0);
+            y += decode_bf16(packed, 1);
+            z += decode_bf16(packed, 2);
+        }
+        const uint64_t packed = uint64_t(encode_bf16(x)) | (uint64_t(encode_bf16(y)) << 16) |
+                                (uint64_t(encode_bf16(z)) << 32);
+        store_three(output, i, elements, packed);
+        const uint64_t packet = (uint64_t(tag ^ 0x8000u) << 48) | packed;
+        uint64_t* address = slot + size_t(rank) * stride + i;
+        asm volatile("st.volatile.global.u64 [%0], %1;" :: "l"(address), "l"(packet) : "memory");
+        __threadfence_system();
+    }
+    grid.sync();
+    for (int packet_index = global_thread; packet_index < packets; packet_index += global_threads) {
+        const int source = packet_index / chunk;
+        if (source == rank) continue;
+        const uint64_t* address = slot + size_t(source) * stride + packet_index;
+        const uint64_t consumed_tag = tag ^ 0x8000u;
+        const uint64_t deadline = clock64() + 180000000000ull;
+        uint64_t packet;
+        do {
+            asm volatile("ld.volatile.global.u64 %0, [%1];" : "=l"(packet) : "l"(address) : "memory");
+            if ((packet >> 48) != consumed_tag && clock64() > deadline) {
+                if (atomicCAS(error, 0, source + 1) == 0) {
+                    error[1] = packet_index; error[2] = uint32_t(packet);
+                    error[3] = uint32_t(packet >> 48); error[4] = uint32_t(consumed_tag); error[5] = 2;
+                }
+                asm volatile("trap;");
+                return;
+            }
+        } while ((packet >> 48) != consumed_tag);
+        store_three(output, packet_index, elements, packet & PayloadMask);
+    }
+}
+
+extern "C" int register_host(void* host, size_t bytes, int device, void** mapped) {
+    cudaError_t e = cudaSetDevice(device);
+    if (e != cudaSuccess) return e;
+    e = cudaHostRegister(host, bytes, cudaHostRegisterPortable | cudaHostRegisterMapped);
+    if (e != cudaSuccess) return e;
+    return cudaHostGetDevicePointer(mapped, host, 0);
+}
+extern "C" int unregister_host(void* host) { return cudaHostUnregister(host); }
+extern "C" const char* error_text(int code) { return cudaGetErrorString(cudaError_t(code)); }
+extern "C" int prepare_kernel() {
+    int device, supported, sms, blocks;
+    cudaError_t e = cudaGetDevice(&device);
+    if (e != cudaSuccess) return e;
+    e = cudaDeviceGetAttribute(&supported, cudaDevAttrCooperativeLaunch, device);
+    if (e != cudaSuccess) return e;
+    if (!supported) return cudaErrorNotSupported;
+    e = cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, device);
+    if (e != cudaSuccess) return e;
+    e = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks, cooperative_triplet_host, Threads, 0);
+    if (e != cudaSuccess) return e;
+    cooperative_block_limit = sms * blocks;
+    return cudaSuccess;
+}
+extern "C" int launch_host_ll(void* input, void* output, void* shared,
+                              void* counter, void* error, int words, int stride,
+                              int rank, int threads, void* stream) {
+    const int packets = (words * 2 + 2) / 3;
+    const int chunk = ((packets + Ranks * 32 - 1) / (Ranks * 32)) * 32;
+    const int blocks = max(1, (chunk + PacketLanes - 1) / PacketLanes);
+    if (blocks > cooperative_block_limit) return cudaErrorCooperativeLaunchTooLarge;
+    void* args[] = {&input, &output, &shared, &counter, &error, &words, &stride, &rank};
+    return cudaLaunchCooperativeKernel(reinterpret_cast<void*>(cooperative_triplet_host),
+        dim3(blocks), dim3(Threads), args, 0, reinterpret_cast<cudaStream_t>(stream));
+}
