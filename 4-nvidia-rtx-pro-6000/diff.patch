+    if (warps == 4) return dispatch_mma<4>(x, w, out, partial, m, xt, xg, splits, cuda_stream);
+    if (warps == 8) return dispatch_mma<8>(x, w, out, partial, m, xt, xg, splits, cuda_stream);
+    return int(cudaErrorInvalidValue);
+}
