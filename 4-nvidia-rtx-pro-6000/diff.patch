+    SFDST,
+    Q,
+    SF,
+    K: tl.constexpr,
+    TOPK: tl.constexpr,
+    XS0,
+    XS1,
+    SF0,
+    SF1,
+    PACKED_XS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    route = tl.program_id(0)
+    block = tl.program_id(1)
+    token = route // TOPK
+    dest = tl.load(DST + route)
+    sfrow = tl.load(SFDST + route)
