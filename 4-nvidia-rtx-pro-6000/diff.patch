+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fp8_pair(packed):
+    return tl.inline_asm_elementwise(
+        "cvt.rn.f16x2.e4m3x2 $0, $1;", constraints="=r,h",
+        args=[packed], dtype=tl.int32, is_pure=True, pack=1)
+
+
+@triton.jit
+def _dot_pair(x, packed):
+    return tl.inline_asm_elementwise(
+        "{ .reg .b32 w, p; .reg .b16 lo, hi; .reg .b8 f4, z; .reg .f32 a, b; "
+        "mov.b16 {f4, z}, $2; cvt.rn.f16x2.e2m1x2 w, f4; "
+        "mul.rn.f16x2 p, w, $1; mov.b32 {lo, hi}, p; "
+        "cvt.f32.f16 a, lo; cvt.f32.f16 b, hi; add.f32 $0, a, b; }",
+        constraints="=f,r,h", args=[x, packed.to(tl.uint16)],
+        dtype=tl.float32, is_pure=True, pack=1)
+
+
+@triton.jit
+def _scale(S, row, k, S0: tl.constexpr, S1: tl.constexpr, PACKED: tl.constexpr, LENGTH: tl.constexpr):
+    if PACKED:
+        word = tl.load(S + row * S0 + (k // 512) * S1, k < LENGTH, 0)
+        exponent = (word >> (((k // 128) % 4) * 8)) & 255
+        return (exponent.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+    else:
+        return tl.load(S + row * S0 + (k // 128) * S1, k < LENGTH, 0).to(tl.float32)
+
+
+@triton.jit
+def _fc1(X, XS, W, WS, IDS, MAP, Y,
+         K: tl.constexpr, I: tl.constexpr, TOPK: tl.constexpr,
+         X0: tl.constexpr, XS0: tl.constexpr, XS1: tl.constexpr,
+         W0: tl.constexpr, W1: tl.constexpr, W2: tl.constexpr,
+         S0: tl.constexpr, S1: tl.constexpr, S2: tl.constexpr,
+         IDS0: tl.constexpr, IDS1: tl.constexpr,
+         HAS_MAP: tl.constexpr, PACKED_XS: tl.constexpr,
+         BN: tl.constexpr, BK: tl.constexpr):
+    route = tl.program_id(0)
+    token = route // TOPK
+    slot = route % TOPK
+    expert = tl.load(IDS + token * IDS0 + slot * IDS1)
+    if HAS_MAP:
+        expert = tl.load(MAP + expert, expert >= 0, -1)
+    n = tl.program_id(1) * BN + tl.arange(0, BN)
+    gate = tl.full((BN, BK), 0, tl.float32)
+    up = tl.full((BN, BK), 0, tl.float32)
+    if expert >= 0:
+        for block in range(triton.cdiv(K, 2 * BK)):
+            p = block * BK + tl.arange(0, BK)
+            k = 2 * p
+            x = _fp8_pair(tl.load(X + token * X0 + p, k < K, 0))
+            xs = _scale(XS, token, k, XS0, XS1, PACKED_XS, K)
+            a = tl.load(W + expert * W0 + n[:, None] * W1 + (k[None, :] // 2) * W2, (n[:, None] < I) & (k[None, :] < K), 0).to(tl.int32)
+            b = tl.load(W + expert * W0 + (n[:, None] + I) * W1 + (k[None, :] // 2) * W2, (n[:, None] < I) & (k[None, :] < K), 0).to(tl.int32)
+            sa = tl.load(WS + expert * S0 + n[:, None] * S1 + (k[None, :] // 128) * S2, (n[:, None] < I) & (k[None, :] < K), 0)
+            sb = tl.load(WS + expert * S0 + (n[:, None] + I) * S1 + (k[None, :] // 128) * S2, (n[:, None] < I) & (k[None, :] < K), 0)
+            sa = (sa >> (((k[None, :] // 32) & 3) * 8)) & 255
+            sb = (sb >> (((k[None, :] // 32) & 3) * 8)) & 255
+            sa = (sa.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+            sb = (sb.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+            gate += _dot_pair(x[None, :], a) * (xs[None, :] * sa)
+            up += _dot_pair(x[None, :], b) * (xs[None, :] * sb)
+    g = tl.sum(gate, 1)
+    u = tl.sum(up, 1)
+    tl.store(Y + route * (2 * I) + n, g, n < I)
+    tl.store(Y + route * (2 * I) + I + n, u, n < I)
+
+
+@triton.jit
+def _fc2_reduce(X, XS, W, WS, IDS, MAP, RW, Y,
+                K: tl.constexpr, I: tl.constexpr, TOPK: tl.constexpr,
+                XS0: tl.constexpr, XS1: tl.constexpr,
+                W0: tl.constexpr, W1: tl.constexpr, W2: tl.constexpr,
+                S0: tl.constexpr, S1: tl.constexpr, S2: tl.constexpr,
+                IDS0: tl.constexpr, IDS1: tl.constexpr,
+                RW0: tl.constexpr, RW1: tl.constexpr,
+                HAS_MAP: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    token = tl.program_id(0)
+    n = tl.program_id(1) * BN + tl.arange(0, BN)
+    result = tl.full((BN,), 0, tl.float32)
+    for slot in range(TOPK):
+        expert = tl.load(IDS + token * IDS0 + slot * IDS1)
+        if HAS_MAP:
+            expert = tl.load(MAP + expert, expert >= 0, -1)
+        if expert >= 0:
+            total = tl.full((BN, BK), 0, tl.float32)
+            route = token * TOPK + slot
+            for block in range(triton.cdiv(I, 2 * BK)):
+                p = block * BK + tl.arange(0, BK)
+                k = 2 * p
+                x = _fp8_pair(tl.load(X + route * (I // 2) + p, k < I, 0))
+                xs = _scale(XS, route, k, XS0, XS1, True, I)
+                w = tl.load(W + expert * W0 + n[:, None] * W1 + (k[None, :] // 2) * W2, (n[:, None] < K) & (k[None, :] < I), 0).to(tl.int32)
+                s = tl.load(WS + expert * S0 + n[:, None] * S1 + (k[None, :] // 128) * S2, (n[:, None] < K) & (k[None, :] < I), 0)
+                s = (s >> (((k[None, :] // 32) & 3) * 8)) & 255
+                s = (s.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+                total += _dot_pair(x[None, :], w) * (xs[None, :] * s)
+            value = tl.sum(total, 1).to(tl.bfloat16).to(tl.float32)
+            weight = tl.load(RW + token * RW0 + slot * RW1)
+            result += value * weight
+    tl.store(Y + token * K + n, result, n < K)
+
