+template<int Warps, int Splits>
+__global__ void woa_bf16_mma(const uint32_t* __restrict__ x,
+        const uint32_t* __restrict__ w, __nv_bfloat16* __restrict__ out,
+        float* __restrict__ partial, int m, int64_t xt, int64_t xg) {
