+import ctypes
+from functools import lru_cache
+
+import torch
+
+
+@lru_cache(None)
+def _supported_device(device):
+    return (
+        torch.cuda.get_device_capability(device) == (12, 0)
+        and torch.cuda.get_device_properties(device).multi_processor_count == 188
+    )
+
+
+@lru_cache(None)
+def _library():
+    library = ctypes.CDLL("/usr/local/lib/libvllm-sm120-g2-wo-a-mma.so")
+    library.launch_woa.argtypes = [ctypes.c_void_p] * 4 + [
+        ctypes.c_int, ctypes.c_int64, ctypes.c_int64, ctypes.c_int,
+        ctypes.c_int, ctypes.c_void_p,
+    ]
+    library.launch_woa.restype = ctypes.c_int
+    return library
+
+
+def small_g2(x, weight, output):
+    if not (
+        x.is_cuda and weight.device == output.device == x.device
+        and x.dtype == weight.dtype == output.dtype == torch.bfloat16
+        and x.ndim == weight.ndim == output.ndim == 3
+        and 1 <= x.shape[0] <= 4
+        and x.shape[1:] == (2, 4096)
+        and weight.shape == (2, 1024, 4096)
+        and output.shape == (x.shape[0], 2, 1024)
+        and weight.is_contiguous() and output.is_contiguous()
+        and x.stride(-1) == 1
+        and x.stride(0) > 0 and x.stride(0) % 2 == 0
+        and x.stride(1) > 0 and x.stride(1) % 2 == 0
+        and x.data_ptr() % 4 == 0 and weight.data_ptr() % 4 == 0
+        and output.data_ptr() % 2 == 0
+        and _supported_device(x.device)
+    ):
+        return False
+    partial = torch.empty(
+        (16, x.shape[0], 2, 1024), device=x.device, dtype=torch.float32
+    )
+    error = _library().launch_woa(
+        x.data_ptr(), weight.data_ptr(), output.data_ptr(), partial.data_ptr(),
+        x.shape[0], x.stride(0), x.stride(1), 8, 16,
+        torch.cuda.current_stream(x.device).cuda_stream,
+    )
+    if error:
+        raise RuntimeError(f"sm120 G2 BF16 WO-A launch failed: {error}")
+    return True
