+@triton.jit(do_not_specialize=["total_pairs"])
+def _count_routes_dynamic(
+    topk_ids, counts, total_pairs, block_n: tl.constexpr
+):
+    pair_idx = tl.program_id(0) * block_n + tl.arange(0, block_n)
+    valid = pair_idx < total_pairs
+    expert = tl.load(topk_ids + pair_idx, mask=valid, other=-1)
+    tl.atomic_add(counts + expert, 1, mask=expert >= 0, sem="relaxed")
+
+@triton.jit(do_not_specialize=["total_pairs"])
+def _route_assign_dynamic(
+    topk_ids,
+    topk_weights,
+    offsets,
+    expert_cursor,
+    token_map,
+    token_weights,
+    dst_rows,
+    scale_dst_rows,
+    total_pairs,
+    top_k: tl.constexpr,
+    scale_align: tl.constexpr,
+    block_n: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs = tl.arange(0, block_n)
+    pair_idx = pid * block_n + offs
+    valid = pair_idx < total_pairs
+    expert = tl.load(topk_ids + pair_idx, mask=valid, other=-1)
+    # Unrouted (negative id) pairs take no row; see the module docstring.
+    routed = expert >= 0
+    routed_row = tl.atomic_add(expert_cursor + expert, 1, mask=routed, sem="relaxed")
+    token_idx = pair_idx // top_k
+    expert_begin = tl.load(offsets + expert, mask=routed, other=0)
+    scale_begin = (expert_begin + expert * (scale_align - 1)) & -scale_align
+    tl.store(token_map + routed_row, token_idx, mask=routed)
+    tl.store(
+        token_weights + routed_row,
+        tl.load(topk_weights + pair_idx, mask=routed, other=0.0),
+        mask=routed,
+    )
+    tl.store(dst_rows + pair_idx, tl.where(routed, routed_row, -1), mask=valid)
+    tl.store(
+        scale_dst_rows + pair_idx,
+        tl.where(routed, scale_begin + routed_row - expert_begin, -1),
+        mask=valid,
+    )
+
+@triton.jit(do_not_specialize=["N"])
+def _map_ids_dynamic(IDS, MAP, LOCAL, N, BLOCK: tl.constexpr):
+    r = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    expert = tl.load(IDS + r, r < N, -1)
+    local = tl.load(MAP + expert, (r < N) & (expert >= 0), -1)
+    tl.store(LOCAL + r, local, r < N)
+
+
+@triton.jit(do_not_specialize=["XS0", "XS1", "SF0", "SF1"])
+def _copy_quantized_dynamic(
+    X,
+    XS,
+    DST,
+    SFDST,
+    Q,
+    SF,
+    K: tl.constexpr,
+    TOPK: tl.constexpr,
+    XS0,
+    XS1,
+    SF0,
+    SF1,
+    PACKED_XS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    route = tl.program_id(0)
+    block = tl.program_id(1)
+    token = route // TOPK
+    dest = tl.load(DST + route)
+    sfrow = tl.load(SFDST + route)
+    cols = block * BLOCK + tl.arange(0, BLOCK)
+    x = tl.load(X + token * K + cols, cols < K, 0)
+    tl.store(Q + dest * K + cols, x, (cols < K) & (dest >= 0))
+    for part in tl.static_range(BLOCK // 512):
+        word = block * (BLOCK // 512) + part
+        if PACKED_XS:
+            scale = tl.load(
+                XS + token * XS0 + word * XS1, word < triton.cdiv(K, 512), 0
+            )
+        else:
+            scale = tl.full((), 0, tl.int32)
+            for group in tl.static_range(4):
+                sf = tl.load(
+                    XS + token * XS0 + (word * 4 + group) * XS1,
+                    word * 4 + group < triton.cdiv(K, 128),
+                    0,
+                )
+                exponent = sf.to(tl.int32, bitcast=True) >> 23 & 255
+                scale = scale | exponent << group * 8
