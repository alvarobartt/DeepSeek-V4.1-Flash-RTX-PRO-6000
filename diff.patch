+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=['PAIRS'])
+def histogram(IDS,H,PAIRS,BINS:tl.constexpr,BLOCK:tl.constexpr):
+    positions=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK)
+    expert=tl.load(IDS+positions,positions<PAIRS,-1)
+    bins=tl.where(expert>=0,expert+1,0)
+    counts=tl.histogram(bins,BINS)
+    tl.store(H+tl.program_id(0)*BINS+tl.arange(0,BINS),counts)
+
+
+@triton.jit(do_not_specialize=['TILES'])
+def tile_prefix(H,COUNTS,TILES,BINS:tl.constexpr,BLOCK_T:tl.constexpr):
+    expert=tl.program_id(0)
+    tiles=tl.arange(0,BLOCK_T)
+    counts=tl.load(H+tiles*BINS+expert+1,tiles<TILES,0)
+    prefix=tl.cumsum(counts)
+    tl.store(H+tiles*BINS+expert+1,prefix-counts,tiles<TILES)
+    tl.store(COUNTS+expert,tl.sum(counts))
+
+
+@triton.jit
+def offsets(COUNTS,OFFSETS,EXPERTS:tl.constexpr,BLOCK_E:tl.constexpr):
+    expert=tl.arange(0,BLOCK_E)
+    counts=tl.load(COUNTS+expert,expert<EXPERTS,0)
+    inclusive=tl.cumsum(counts)
+    tl.store(OFFSETS+expert,inclusive-counts,expert<EXPERTS)
+    tl.store(OFFSETS+EXPERTS,tl.sum(counts))
+
+
+@triton.jit
+def maximum(a,b):
+    return tl.maximum(a,b)
+
+
+@triton.jit(do_not_specialize=['PAIRS'])
+def scatter(IDS,WEIGHTS,H,OFFSETS,TOKEN_MAP,TOKEN_WEIGHTS,DST,SFDST,
+            PAIRS,TOPK:tl.constexpr,BINS:tl.constexpr,ALIGN:tl.constexpr,BLOCK:tl.constexpr):
+    tile=tl.program_id(0)
+    local=tl.arange(0,BLOCK)
+    pair=tile*BLOCK+local
+    expert=tl.load(IDS+pair,pair<PAIRS,-1)
+    bucket=tl.where(expert>=0,expert+1,0)
+    keys=tl.sort(bucket*BLOCK+local,descending=False)
+    sorted_expert=keys//BLOCK-1
+    original=keys%BLOCK
+    previous=tl.gather(sorted_expert,tl.maximum(local-1,0),0)
+    begin=tl.where((local==0)|(sorted_expert!=previous),local,0)
+    begin=tl.associative_scan(begin,0,maximum)
+    rank=local-begin
+    valid=sorted_expert>=0
+    expert_begin=tl.load(OFFSETS+sorted_expert,valid,0)
+    earlier=tl.load(H+tile*BINS+sorted_expert+1,valid,0)
+    destination=expert_begin+earlier+rank
+    scale_begin=(expert_begin+sorted_expert*(ALIGN-1))&-ALIGN
+    original_pair=tile*BLOCK+original
+    weight=tl.load(WEIGHTS+original_pair,valid,0.0)
+    tl.store(TOKEN_MAP+destination,original_pair//TOPK,valid)
+    tl.store(TOKEN_WEIGHTS+destination,weight,valid)
+    tl.store(DST+original_pair,tl.where(valid,destination,-1),original_pair<PAIRS)
+    tl.store(SFDST+original_pair,tl.where(valid,scale_begin+earlier+rank,-1),original_pair<PAIRS)
+
+
+_KERNELS={}
+_CALLS=0
+_SHAPES=set()
+
+
+def launch(kind,jit,args,grid,key):
+    full_key=(kind,args[0].device.index,*key)
+    grid=tuple(grid)+(1,)*(3-len(grid))
+    if full_key not in _KERNELS:
+        _KERNELS[full_key]=jit.warmup(*args,grid=grid,num_warps=4,num_stages=1)
+    _KERNELS[full_key][grid](*args)
+
+
+def assign(ids,weights,workspace,experts,align=128):
+    global _CALLS
+    _CALLS+=1
+    pairs=ids.numel()
+    _SHAPES.add((ids.shape[0],ids.shape[1],experts))
+    assert ids.dtype==torch.int32 and workspace.scale_out.is_contiguous()
