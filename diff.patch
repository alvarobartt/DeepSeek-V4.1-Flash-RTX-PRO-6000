+__device__ __forceinline__ uint32_t unpack_pair(uint16_t value, uint8_t scale) {
+    union Pair { __half2_raw halves; uint32_t bits; } pair;
+    pair.halves = __nv_cvt_fp8x2_to_halfraw2(value, __NV_E4M3);
+    const uint32_t low = pair.bits & 0xffffu;
+    const uint32_t high = pair.bits >> 16;
+    const uint32_t shift = (uint32_t(scale) - 15u) << 7;
+    const uint32_t a = (low & 0x7fffu) ? ((low & 0x7fffu) >> 3) + shift : 0;
+    const uint32_t b = (high & 0x7fffu) ? ((high & 0x7fffu) >> 3) + shift : 0;
+    return (a | (low & 0x8000u)) | ((b | (high & 0x8000u)) << 16);
+}
+
+__global__ void unpack_weight(const uint16_t* weight, const uint8_t* scales,
+                              uint32_t* output, int pairs) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= pairs) return;
+    const int row = i / 2048;
+    const int channel = i % 2048;
+    output[i] = unpack_pair(weight[i], scales[(row / 32) * 128 + channel / 16]);
+}
+
+__device__ unsigned long long woa_execution_histogram[36] = {};
+
+template<int Warps, int Splits, int Groups, bool Packed>
+__global__ void woa_register_mma(const uint32_t* __restrict__ x,
+        const void* __restrict__ weight, const uint8_t* __restrict__ scales,
+        __nv_bfloat16* __restrict__ out, float* __restrict__ partial,
+        int m, int64_t xt, int64_t xg) {
+    if(blockIdx.x==0&&blockIdx.y==0&&blockIdx.z==0&&threadIdx.x==0)
+        atomicAdd(woa_execution_histogram+(int(Packed)*2+Groups-1)*9+m,1ULL);
+    const int lane = threadIdx.x & 31;
+    const int row = lane / 4;
+    const int part = lane % 4;
+    const int nbase = (blockIdx.x * Warps + threadIdx.x / 32) * 8;
+    const int batch = blockIdx.y;
+    const int split = blockIdx.z;
+    const int begin = split * (4096 / Splits);
+    const int end = begin + 4096 / Splits;
+    float c0=0,c1=0,c2=0,c3=0;
+    #pragma unroll 2
+    for (int k=begin;k<end;k+=16) {
