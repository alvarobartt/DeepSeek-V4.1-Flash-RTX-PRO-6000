+    tiles=triton.cdiv(pairs,block)
+    bins=triton.next_power_of_2(experts+1)
+    assert tiles*bins<=workspace.scale_out.numel()
+    hist=workspace.scale_out.view(-1)[:tiles*bins].view(tiles,bins)
+    launch('histogram',histogram,(ids,hist,pairs,bins,block),(tiles,),(bins,))
+    block_t=max(64,triton.next_power_of_2(tiles))
+    launch('tile_prefix',tile_prefix,(hist,workspace.counts,tiles,bins,block_t),(experts,),(bins,block_t))
+    launch('offsets',offsets,(workspace.counts,workspace.offsets,experts,triton.next_power_of_2(experts)),(1,),(experts,))
+    launch('scatter',scatter,(ids,weights,hist,workspace.offsets,workspace.token_map,workspace.token_weights,
+           workspace.dst_rows,workspace.scale_dst_rows,pairs,ids.shape[1],bins,align,block),
+           (tiles,),(ids.shape[1],bins,align,weights.dtype))
+    workspace.scale_out.zero_()
+    return workspace
