+    tl.store(token_map + routed_row, token_idx, mask=pair_routed)
+    tl.store(
+        token_weights + routed_row,
+        tl.load(topk_weights + pid, mask=pair_routed, other=0.0),
+        mask=pair_routed,
+    )
+    tl.store(dst_rows + pid, tl.where(pair_routed, routed_row, -1), mask=is_pair)
