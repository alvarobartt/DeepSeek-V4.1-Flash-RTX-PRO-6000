+@triton.jit
+def _scale(S, row, k, S0: tl.constexpr, S1: tl.constexpr, PACKED: tl.constexpr, LENGTH: tl.constexpr):
+    if PACKED:
+        word = tl.load(S + row * S0 + (k // 512) * S1, k < LENGTH, 0)
+        exponent = (word >> (((k // 128) % 4) * 8)) & 255
+        return (exponent.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+    else:
+        return tl.load(S + row * S0 + (k // 128) * S1, k < LENGTH, 0).to(tl.float32)
+
