+
+template<int Warps,int Groups,bool Packed>
+int dispatch(void* x,void* w,void* sf,void* out,void* partial,int m,
+             int64_t xt,int64_t xg,int splits,cudaStream_t stream) {
+    if(splits==1)return launch<Warps,1,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,stream);
+    if(splits==2)return launch<Warps,2,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,stream);
