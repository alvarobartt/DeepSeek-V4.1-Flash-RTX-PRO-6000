+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=['NON','BUDGET','BONUS','N'])
+def _initialize(CAP,NON_DRAFT,CU,QUERY,NON,BUDGET,BONUS,N,BLOCK:tl.constexpr):
+    row=tl.program_id(0)*BLOCK+tl.arange(0,BLOCK)
+    tl.store(CAP+row,BUDGET,row==0)
+    tl.store(NON_DRAFT+row,NON,row==0)
+    tl.store(CU+row,tl.where(row==0,0,BUDGET+BONUS),row<2)
+    tl.store(QUERY+row,tl.where(row==0,0,NON+BUDGET),row<N)
+
+
+def initialize(capacity,non_draft,cu,query,non,budget,bonus):
+    n=query.numel()
+    _initialize[triton.cdiv(n,256),](capacity,non_draft,cu,query,
+                                    int(non),int(budget),int(bonus),n,256,num_warps=4)
+
+
+def warmup(capacity,non_draft,cu,query,bonus):
+    n=query.numel()
+    _initialize.warmup(capacity,non_draft,cu,query,0,0,int(bonus),n,256,
+                       grid=(triton.cdiv(n,256),),num_warps=4)
