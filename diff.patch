+            a = tl.load(W + expert * W0 + n[:, None] * W1 + (k[None, :] // 2) * W2, (n[:, None] < I) & (k[None, :] < K), 0).to(tl.int32)
+            b = tl.load(W + expert * W0 + (n[:, None] + I) * W1 + (k[None, :] // 2) * W2, (n[:, None] < I) & (k[None, :] < K), 0).to(tl.int32)
+            sa = tl.load(WS + expert * S0 + n[:, None] * S1 + (k[None, :] // 128) * S2, (n[:, None] < I) & (k[None, :] < K), 0)
+            sb = tl.load(WS + expert * S0 + (n[:, None] + I) * S1 + (k[None, :] // 128) * S2, (n[:, None] < I) & (k[None, :] < K), 0)
+            sa = (sa >> (((k[None, :] // 32) & 3) * 8)) & 255
+            sb = (sb >> (((k[None, :] // 32) & 3) * 8)) & 255
+            sa = (sa.to(tl.int32) << 23).to(tl.float32, bitcast=True)
+            sb = (sb.to(tl.int32) << 23).to(tl.float32, bitcast=True)
