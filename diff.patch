+    XS,
+    DST,
+    SFDST,
+    Q,
+    SF,
+    K: tl.constexpr,
+    TOPK: tl.constexpr,
+    XS0,
+    XS1,
+    SF0,
+    SF1,
+    PACKED_XS: tl.constexpr,
