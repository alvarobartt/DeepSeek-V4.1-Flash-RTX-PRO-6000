+@triton.jit(do_not_specialize=['total_pairs', 'total_scale', 'padded_rows', 's_som', 's_sok'])
+def _route_jit(
+    topk_ids,
+    topk_weights,
+    offsets,
+    token_map,
+    token_weights,
+    dst_rows,
+    scale_dst_rows,
+    scale_out,
+    total_pairs,
+    top_k: tl.constexpr,
+    num_experts: tl.constexpr,
+    scale_align: tl.constexpr,
+    block_n: tl.constexpr,
+    total_scale,
+    padded_rows,
+    s_som,
+    s_sok,
+):
+    pid = tl.program_id(0)
+    offs = tl.arange(0, block_n)
+    # Unrouted (negative id) pairs take no row; see the module docstring.
+    experts = tl.load(topk_ids + offs, mask=offs < total_pairs, other=-1)
+    routed = experts >= 0
+    flat = pid * block_n + offs
+    tl.store(scale_out + flat, 0, mask=flat < total_scale)
