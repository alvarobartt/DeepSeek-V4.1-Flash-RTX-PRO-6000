+    key=(q.device.index,width,splits)
+    if key not in _COMPILED:
+        sms=torch.cuda.get_device_properties(q.device).multi_processor_count
+        _COMPILED[key]=cute.compile(CuteDslSm120MoeMxfp8Mxfp4Grouped(config,sms,splits),*args)
+    _COMPILED[key](*args)
