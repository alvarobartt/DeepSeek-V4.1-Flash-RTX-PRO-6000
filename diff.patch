+@triton.jit
+def _fc2_reduce(X, XS, W, WS, IDS, MAP, RW, Y,
+                K: tl.constexpr, I: tl.constexpr, TOPK: tl.constexpr,
+                XS0: tl.constexpr, XS1: tl.constexpr,
+                W0: tl.constexpr, W1: tl.constexpr, W2: tl.constexpr,
+                S0: tl.constexpr, S1: tl.constexpr, S2: tl.constexpr,
+                IDS0: tl.constexpr, IDS1: tl.constexpr,
+                RW0: tl.constexpr, RW1: tl.constexpr,
+                HAS_MAP: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    token = tl.program_id(0)
+    n = tl.program_id(1) * BN + tl.arange(0, BN)
