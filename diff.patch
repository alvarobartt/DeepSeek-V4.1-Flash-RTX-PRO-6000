+import triton
+import triton.language as tl
+
+
+@triton.jit
+def count_experts(IDS, COUNTS, PAIRS: tl.constexpr, BLOCK: tl.constexpr):
+    expert = tl.program_id(0)
+    lane = tl.arange(0, BLOCK)
+    count = tl.full((), 0, tl.int32)
+    for block in range(tl.cdiv(PAIRS, BLOCK)):
+        index = block * BLOCK + lane
+        ids = tl.load(IDS + index, index < PAIRS, -1)
+        count += tl.sum((ids == expert).to(tl.int32), 0)
+    tl.store(COUNTS + expert, count)
+
+
+@triton.jit
+def prefix_counts(COUNTS, OFFSETS, EXPERTS: tl.constexpr, BLOCK: tl.constexpr):
+    expert = tl.arange(0, BLOCK)
+    counts = tl.load(COUNTS + expert, expert < EXPERTS, 0)
+    ends = tl.cumsum(counts)
+    tl.store(OFFSETS, 0)
+    tl.store(OFFSETS + expert + 1, ends, expert < EXPERTS)
+
+
+@triton.jit
+def scatter_expert(IDS, WEIGHTS, OFFSETS, TOKEN_MAP, TOKEN_WEIGHTS, DST, SF_DST,
+                   PAIRS: tl.constexpr, TOPK: tl.constexpr, EXPERTS: tl.constexpr,
+                   ALIGN: tl.constexpr, BLOCK: tl.constexpr):
+    expert = tl.program_id(0)
+    start = tl.load(OFFSETS + expert)
+    scale_start = (start + expert * (ALIGN - 1)) & -ALIGN
+    lane = tl.arange(0, BLOCK)
+    earlier = tl.full((), 0, tl.int32)
+    for block in range(tl.cdiv(PAIRS, BLOCK)):
+        index = block * BLOCK + lane
+        ids = tl.load(IDS + index, index < PAIRS, -1)
+        selected = (index < PAIRS) & (ids == expert)
+        prefix = tl.cumsum(selected.to(tl.int32))
+        rank = earlier + prefix - 1
+        row = start + rank
+        weight = tl.load(WEIGHTS + index, selected, 0)
+        tl.store(TOKEN_MAP + row, index // TOPK, selected)
+        tl.store(TOKEN_WEIGHTS + row, weight, selected)
+        tl.store(DST + index, row, selected)
+        tl.store(SF_DST + index, scale_start + rank, selected)
+        if expert == 0:
+            invalid = (index < PAIRS) & ((ids < 0) | (ids >= EXPERTS))
+            tl.store(DST + index, -1, invalid)
+            tl.store(SF_DST + index, -1, invalid)
+        earlier += tl.sum(selected.to(tl.int32), 0)
+
+
+def route_large(ids, weights, workspace, experts, align=128):
+    pairs = ids.numel()
+    workspace.scale_out.zero_()
+    count_experts[(experts,)](ids, workspace.counts, pairs, 1024, num_warps=4)
+    prefix_counts[(1,)](workspace.counts, workspace.offsets, experts,
+                        triton.next_power_of_2(experts), num_warps=4)
+    scatter_expert[(experts,)](ids, weights, workspace.offsets, workspace.token_map,
+                              workspace.token_weights, workspace.dst_rows,
+                              workspace.scale_dst_rows, pairs, ids.shape[1], experts,
+                              align, 1024, num_warps=4)
+    return workspace
