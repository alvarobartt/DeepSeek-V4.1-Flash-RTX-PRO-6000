+@triton.jit
+def _fp8_pair(packed):
+    return tl.inline_asm_elementwise(
+        "cvt.rn.f16x2.e4m3x2 $0, $1;", constraints="=r,h",
+        args=[packed], dtype=tl.int32, is_pure=True, pack=1)
+
+
+@triton.jit
+def _dot_pair(x, packed):
+    return tl.inline_asm_elementwise(
+        "{ .reg .b32 w, p; .reg .b16 lo, hi; .reg .b8 f4, z; .reg .f32 a, b; "
+        "mov.b16 {f4, z}, $2; cvt.rn.f16x2.e2m1x2 w, f4; "
+        "mul.rn.f16x2 p, w, $1; mov.b32 {lo, hi}, p; "
+        "cvt.f32.f16 a, lo; cvt.f32.f16 b, hi; add.f32 $0, a, b; }",
+        constraints="=f,r,h", args=[x, packed.to(tl.uint16)],
+        dtype=tl.float32, is_pure=True, pack=1)
+
