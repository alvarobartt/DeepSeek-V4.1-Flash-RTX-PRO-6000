+    if(splits==8)return launch<Warps,8,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,stream);
+    if(splits==16)return launch<Warps,16,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,stream);
+    return int(cudaErrorInvalidValue);
+}
+
+template<int Groups,bool Packed>
+int choose_warps(void* x,void* w,void* sf,void* out,void* partial,int m,
+                 int64_t xt,int64_t xg,int warps,int splits,cudaStream_t stream) {
+    if(warps==4)return dispatch<4,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,splits,stream);
+    if(warps==8)return dispatch<8,Groups,Packed>(x,w,sf,out,partial,m,xt,xg,splits,stream);
+    return int(cudaErrorInvalidValue);
