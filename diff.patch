+@triton.jit(do_not_specialize=['PAIRS','AS1'])
+def project(Q,W,AS,BS,MAP,DST,IDS,OFF,P,PAIRS,K:tl.constexpr,H:tl.constexpr,
+            AS0:tl.constexpr,AS1,BS0:tl.constexpr,BS1:tl.constexpr,BS2:tl.constexpr,
+            PACKED:tl.constexpr,BK:tl.constexpr,BM:tl.constexpr,SPLITS:tl.constexpr,CAP:tl.constexpr):
+    pair=tl.program_id(1)
+    expert=tl.load(IDS+pair)
+    destination=tl.load(DST+pair)
+    if expert>=0:
+        first=tl.load(OFF+expert);end=tl.load(OFF+expert+1)
+        if (destination-first)%BM==0:
+            row=destination+tl.arange(0,BM)
+            source=tl.load(MAP+row,row<end,0)
+            cols=tl.program_id(0)*128+tl.arange(0,128)
+            ki=tl.arange(0,BK);kp=tl.arange(0,BK//2);groups=tl.arange(0,BK//32)
+            gate=tl.full((128,BM),0,tl.float32);up=tl.full((128,BM),0,tl.float32)
+            steps:tl.constexpr=triton.cdiv(K,BK*SPLITS)
+            for step in range(steps):
+                block=tl.program_id(2)*steps+step
+                channels=block*BK+ki
+                q=tl.load(Q+source[:,None]*K+channels[None,:],(row[:,None]<end)&(channels[None,:]<K),0.)
+                packed=block*(BK//2)+kp
+                pointer=W+expert*(2*H)*(K//2)+cols[:,None]*(K//2)+packed[None,:]
+                wg=tl.load(pointer,(cols[:,None]<H)&(packed[None,:]<K//2),0)
+                wu=tl.load(pointer+H*(K//2),(cols[:,None]<H)&(packed[None,:]<K//2),0)
+                group=block*(BK//32)+groups;ag=group//4
+                if PACKED:
+                    word=tl.load(AS+source[:,None]*AS0+(ag[None,:]//4)*AS1,(row[:,None]<end)&(group[None,:]<K//32),0)
+                    qs=((word>>((ag[None,:]%4)*8))&255).to(tl.uint8)
+                else:
+                    value=tl.load(AS+source[:,None]*AS0+ag[None,:]*AS1,(row[:,None]<end)&(group[None,:]<K//32),0.)
+                    qs=((value.to(tl.int32,bitcast=True)>>23)&255).to(tl.uint8)
+                scale_pointer=BS+expert*BS0+cols[:,None]*BS1+(group[None,:]//4)*BS2
+                gs=tl.load(scale_pointer,(cols[:,None]<H)&(group[None,:]<K//32),0)
+                us=tl.load(scale_pointer+H*BS1,(cols[:,None]<H)&(group[None,:]<K//32),0)
+                gs=((gs>>((group[None,:]%4)*8))&255).to(tl.uint8)
+                us=((us>>((group[None,:]%4)*8))&255).to(tl.uint8)
+                g=tl.interleave((wg&15)<<2,(wg>>4)<<2).to(tl.float8e4nv,bitcast=True)
+                u=tl.interleave((wu&15)<<2,(wu>>4)<<2).to(tl.float8e4nv,bitcast=True)
+                gate=tl.dot_scaled(g,gs,'e4m3',tl.trans(q),qs,'e4m3',acc=gate)
+                up=tl.dot_scaled(u,us,'e4m3',tl.trans(q),qs,'e4m3',acc=up)
+            output=P+tl.program_id(2)*CAP*(2*H)+row[:,None]*(2*H)+cols[None,:]
+            tl.store(output,tl.trans(gate),(row[:,None]<end)&(cols[None,:]<H))
+            tl.store(output+H,tl.trans(up),(row[:,None]<end)&(cols[None,:]<H))
+
+
+@triton.jit(do_not_specialize=['PAIRS'])
+def activate(P,OFF,Q,S,PAIRS,E:tl.constexpr,H:tl.constexpr,ALIGNED:tl.constexpr,
+             SPLITS:tl.constexpr,CAP:tl.constexpr,LIMIT,ALPHA,BETA,HAS_CLAMP:tl.constexpr):
+    row=tl.program_id(0);pack=tl.program_id(1)
+    col=pack*512+tl.arange(0,512)
+    valid_rows=tl.load(OFF+E)
+    mask=(row<valid_rows)&(col<H)
+    pointer=P+row*(2*H)+col
+    gate=tl.load(pointer,mask,0.);up=tl.load(pointer+H,mask,0.)
+    for split in range(1,SPLITS):
+        gate+=tl.load(pointer+split*CAP*(2*H),mask,0.)
+        up+=tl.load(pointer+H+split*CAP*(2*H),mask,0.)
