+_COMPILED={}
+
+def project(q,scales,weight,weight_scales,offsets,partial,splits,ids,destinations):
+    width=weight.shape[1]
+    tile=(8,64,128)
+    config=make_cfg(tile,4,epi=EpiMethod.DIRECT_STG)
+    output=partial.view(splits*64,width)
+    args=make_args(q,scales,weight,weight_scales,output,offsets,config.epi,config.TILE)
