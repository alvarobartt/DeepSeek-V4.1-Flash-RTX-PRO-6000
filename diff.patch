+    tl.store(Q+row*H+col,tl.reshape(quantized,(512,)),col<H)
+    code=tl.clamp(exponent+127.,0.,255.).to(tl.int32)
+    word=tl.sum(code<<(tl.arange(0,4)*8),0)
+    tl.store(S+pack*ALIGNED+row,word)
